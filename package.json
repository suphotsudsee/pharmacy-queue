{
  "name": "pharmacy-queue-tts-local-v5",
  "version": "1.0.0",
  "private": true,
"scripts": {
  "dev:web": "next dev -p 3000",
  "build:web": "next build",
  "start:web": "next start -p 3000",
  "dev": "npm-run-all -p dev:web dev:electron:wait",
  "dev:electron:wait": "wait-on tcp:3000 && cross-env NEXT_DEV_SERVER_URL=http://localhost:3000 electron .",
  "start": "electron .",
  "pack": "npm run build:web && electron-builder --dir",
  "dist": "npm run build:web && electron-builder"
},
  "dependencies": {
    "-": "^0.0.1",
    "@google-cloud/text-to-speech": "^6.3.0",
    "cross-env": "^10.0.0",
    "next": "14.2.5",
    "npm-run-all": "^4.1.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "wait-on": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "typescript": "5.5.3"
  },
  "main": "electron-main.js",
"build": {
  "appId": "com.pharmacy.queue",
  "productName": "Pharmacy Queue",
  "files": [
    ".next/**",
    "public/**",
    "electron/**",
    "electron-main.js",
    "next.config.*",
    "package.json",
    "tsconfig.json",
    "app/**",
    "components/**",
    "lib/**"
  ],
  "directories": {
    "buildResources": "public",
    "output": "dist"
  },
  "asar": true,
  "win": { "target": "nsis", "icon": "public/icon.ico" },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}

}
